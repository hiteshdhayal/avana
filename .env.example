# Copy to .env.local and fill in before launch. Nothing here is a secret
# value — these are the variable names the app reads; see README.md
# "Environment variables" for what each one does and why it's optional.

# --- Compliance --------------------------------------------------------
# Setting Plan A live requires written sign-off from the developer's
# counsel (spec 3.4). Never flip this without that sign-off.
NEXT_PUBLIC_SHOW_PLAN_A=false

# --- Enquiry form: bot protection --------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Enquiry form: sales notification email ----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Avana Enclave 18 <onboarding@resend.dev>"
SALES_NOTIFICATION_EMAIL=

# --- Enquiry form: lead sheet -------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE="Leads!A:L"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Location -------------------------------------------------------------
# Google Static Maps key. Without it, the location section and enquiry
# sidebar fall back to an address + "Open in Google Maps" search link.
MAPS_STATIC_KEY=
